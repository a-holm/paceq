[2.1937, "o", "paceq import crontab --file crontab.txt --tz Europe/Oslo -o imported/\r\n"]
[2.5437, "o", "Created:\r\n  paceq.yaml       project config\r\n  jobs/hello.yaml  an example job that runs as it stands\r\n  .paceq/state.db  state (schema 13, WAL, auto_vacuum INCREMENTAL)\r\n  .gitignore       .paceq/ added\r\n\r\nNext steps:\r\n  paceq doctor     check the installation\r\n  paceq validate   check the job files\r\n  paceq run hello  run the example job now\r\n"]
[2.8937, "o", "\u001b[?2004h"]
[3.2437, "o", "$ paceq import crontab --file crontab.txt --tz Europe/Oslo -o imported/\r\n\u001b[?2004l\r"]
[3.5937, "o", "5 lines read -> 4 jobs, 0 to review"]
[3.9437, "o", "\r\n"]
[4.2937, "o", "  ⚠  1 job wrapped its command in flock -> replaced with max_concurrent: 1\r\n"]
[4.6437, "o", "  ⓘ 1 wrote log files"]
[4.9937, "o", "\r\n"]
[5.3437, "o", "\r\n"]
[5.6937, "o", "Next steps:  paceq validate imported/\r\n"]
[6.0437, "o", "             paceq apply imported/\r\n"]
[6.3048, "o", "             paceq import crontab --shadow      # run alongside cron without executing anything (v0.2)"]
[6.3049, "o", "\r\n"]
[6.3078, "o", "\u001b[?2004h$ "]
[6.6578, "o", "cat imported/run-backup.yaml\r\n\u001b[?2004l\r"]
[6.711, "o", "# originally: 0 3 * * * cd /srv/backup && ./run-backup.sh >> /var/log/backup.log 2>&1\r\nname: run-backup\r\nworkdir: /srv/backup\r\ntimeout: 1h                  # explicit so you can see it and adjust it\r\nschedules:\r\n  - name: cron\r\n    cron: \"0 3 * * *\"\r\n    timezone: Europe/Oslo        # from --tz\r\nsteps:\r\n  - name: main\r\n    run: [\"/srv/backup/run-backup.sh\"]\r\n# NOTE: the log went to /var/log/backup.log; it lives in `paceq logs <name>` now\r\n"]
[6.7112, "o", "\u001b[?2004h$ "]
[7.0612, "o", "paceq validate imported/ && paceq apply imported/\r\n"]
[7.4112, "o", "\u001b[?2004l\r"]
[7.7612, "o", "✓ no problems\r\n"]
[8.1112, "o", "✓ collect-metrics  new  version 1  sha256:a4cab8e54d23\r\n✓ nightly-report   new  version 1  sha256:2bdad033e4ca\r\n✓ run-backup       new  version 1  sha256:cc1f3267e1b7\r\n✓ true             new  version 1  sha256:8e631dcf4000\r\n\r\n✓ 4 jobs\r\n"]
[8.38, "o", "\u001b[?2004h$ "]
[8.73, "o", "paceq run true\r\n\u001b[?2004l\r"]
