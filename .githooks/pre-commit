#!/bin/sh
# Fast gate. Anything slower belongs in pre-push.
#
# The checks run against a materialised copy of the index, not the working tree.
# Checking the working tree passes commits whose staged content is broken, which
# is exactly the case a partial "git add" produces.
set -e

if ! command -v make >/dev/null 2>&1; then
	echo "pre-commit: make not found." >&2
	exit 1
fi

# D is in the filter on purpose. A staged deletion changes what the tree compiles
# to, so it has to reach go vet even though there is no file left to format.
if [ -z "$(git diff --cached --name-only --diff-filter=ACMRD -- '*.go' go.mod go.sum)" ]; then
	exit 0
fi

staged_tree=$(mktemp -d)
trap 'rm -rf "$staged_tree"' EXIT INT TERM

git checkout-index -a -f --prefix="$staged_tree/"

# Through make, so the hook, `make ci` and the pipeline all run the gofumpt
# version pinned in the Makefile.
if ! (cd "$staged_tree" && make fmt-check); then
	echo "pre-commit: the staged content is not gofumpt clean." >&2
	exit 1
fi

if ! (cd "$staged_tree" && make vet); then
	echo "pre-commit: go vet failed on the staged content." >&2
	exit 1
fi
