# explain sensor is the product's signature surface (10 section 5): the last
# evaluations, the cursor, the breaker, and the job's standing, one screen.
# Three identical skips are one line saying how many, because the writer folds
# them onto one row.

exec paceq init
plantsensor nye-filer prosesser-fil '["/bin/echo","{}"]'
# The triggered tick comes first in time: its helper leaves a fixed cursor
# stamp behind, and the later skips move next_eval_at to the fixture clock.
plantsensortick nye-filer -at=-4m
plantsensorskip nye-filer 'no new files since 04:00' -at=-3m
plantsensorskip nye-filer 'no new files since 04:00' -at=-2m
plantsensorskip nye-filer 'no new files since 04:00' -at=-1m

# The human record: what was evaluated, what it decided, and why.
exec paceq explain sensor nye-filer --since 10m -o text
cp stdout actual_sensor.txt
maskfile actual_sensor.txt
cmp actual_sensor.txt expected_sensor.txt

# The machine record carries the same facts.
exec paceq explain sensor nye-filer --since 10m -o json
cp stdout actual_sensor.json
maskfile actual_sensor.json
cmpjson actual_sensor.json expected_sensor.json

# An unknown sensor refuses with exit 3.
wantexit 3 nf_out.txt nf_err.txt explain sensor sensor/mangler
grep 'no sensor named' nf_err.txt
wantexit 3 nb_out.txt nb_err.txt explain sensor mangler
grep 'nothing named' nb_err.txt

-- expected_sensor.txt --
sensor nye-filer (of job prosesser-fil)
summary: never succeeded, last outcome skipped, next 2026-09-24 09:01 (1m00s from now) paused=false active runs 1/10 freshness=unknown

  2026-09-24 08:57:00Z  skipped tick         01M39A3RV0  x2 coalesced  WARN
       TICK_SKIPPED_SENSOR
       no new files since 04:00
       -> read reason_text on this tick: the sensor's own wording is kept there
  2026-09-24 08:56:00Z  triggered tick         01M39A1Y80  OK
       cursor "a" -> "b"
      2026-09-24 08:56:00Z  accepted trigger      01M39A1Y80  OK
               TRIGGER_ACCEPTED
               became a run
               -> nothing to fix; follow the run id on the trigger row
               -> dedup keys stay until retention clears them, so a deliberate rerun needs a new key or a bumped epoch
          2026-09-24 08:56:00Z  queued  run          01M39A1Y80  WARN
