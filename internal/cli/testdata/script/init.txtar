# init creates a project that works, and never touches one that is already there.

exec paceq init -o text
stdout 'Created:'
stdout 'Next steps:'
exists paceq.yaml
exists jobs/hello.yaml
exists .paceq/state.db
exists .gitignore

# The example job runs an argv array, never a shell string.
grep 'run: \[' jobs/hello.yaml

# The state directory is kept out of version control.
grep '^\.paceq/$' .gitignore

# What init created, doctor approves of. On a host without the hardened
# systemd unit (every development machine and CI runner, and this one) the
# sandbox finding warns and says how to fix it; nothing init created is a
# failure.
exec paceq doctor
stdout '"status":"warn"'
stdout '"level":"warn","title":"sandbox"'
stdout 'paceq install-service'
! stdout '"level":"fail"'

# A second init refuses, and says how to start over.
! exec paceq init
stderr 'already initialised'
stderr 'paceq doctor'
