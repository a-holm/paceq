# explain job answers the only question that matters after silence: why did
# nothing happen. The fixture plants what M1 through M4 persist - coalesced
# skips, a real trigger with its queued run, an outage with synthetic missed
# ticks - and the report reads them back as one reverse chronological list.
# The daemon is never started: explain answers from the state database alone.

exec paceq init
plantschedule nightly-report nightly '0 2 * * *'
plantscheduletick nightly-report nightly SKIPPED TICK_SKIPPED_PAUSED 12
plantscheduletick nightly-report nightly TRIGGERED key -at=1h
plantoutage -9h -8h51m crash nightly-report/nightly 2

# A person at a terminal gets prose with reasons and remedies.
exec paceq explain job nightly-report --since 48h -o text
cp stdout actual_job.txt
maskfile actual_job.txt
cmp actual_job.txt expected_job.txt

# A pipe gets the versioned document, schema_version 1.
exec paceq explain job nightly-report --since 48h -o json
cp stdout actual_job.json
maskfile actual_job.json
cmpjson actual_job.json expected_job.json

# The schedule subject answers from the same one model.
exec paceq explain schedule nightly-report.nightly -o json
cp stdout actual_sched.json
maskfile actual_sched.json
cmpjson actual_sched.json expected_sched.json
exec paceq explain schedule nightly-report/nightly --since 1h -o text
stdout 'schedule nightly-report.nightly'

# A bare unique schedule name resolves without the namespace.
exec paceq explain nightly --since 1h -o text
stdout 'schedule nightly-report.nightly'

# The daemon-down marker is a warning on stderr; stdout stays clean for pipes.
wantexit 0 dd_out.txt dd_err.txt explain job nightly-report --since 1h -o text
grep 'daemon down' dd_err.txt
grep 'summary:' dd_out.txt
! grep 'daemon' dd_out.txt

# A bad window is usage (exit 2); an unknown job is not-found (exit 3).
wantexit 2 since_err_out.txt since_err.txt explain job nightly-report --since nonsense
grep 'not a positive duration' since_err.txt
wantexit 3 missing_out.txt missing_err.txt explain job job/no-such-job
grep 'no job named' missing_err.txt
wantexit 3 bare_out.txt bare_err.txt explain job no-such-thing
grep 'nothing named' bare_err.txt

# When everything is fine the report still answers (09 US-16): a real run at
# a later instant gives the summary a success, an outcome and a duration.
# It runs under a moved clock so the new run unambiguously sorts newest; the
# frozen clock makes every delta in the report a constant.
env PULSEQ_FAKE_CLOCK=2026-09-24T12:00:00Z
wantexit 0 us16_out.txt us16_err.txt run nightly-report
exec paceq explain job nightly-report --since 96h -o text
stdout 'last succeeded 2026-09-24 12:00'
stdout 'last outcome succeeded'

-- expected_job.txt --
job nightly-report
summary: never succeeded, last outcome queued, next 2026-09-24 10:00 (1h00m from now) paused=false active runs 1/4 freshness=unknown

  2026-09-24 00:06:00Z  missed  tick         01M38BQFJ0  WARN
       TICK_MISSED_DAEMON_DOWN
       no daemon was running (gap detection)
       -> treat these rows as outage evidence, not as measurements
       -> compare them against the daemon session rows covering the same period
  2026-09-24 00:03:00Z  missed  tick         01M38BHZS0  WARN
       TICK_MISSED_DAEMON_DOWN
       no daemon was running (gap detection)
       -> treat these rows as outage evidence, not as measurements
       -> compare them against the daemon session rows covering the same period
  2026-09-24 00:00:00Z  missed  outage       1  9m00s  WARN
       TICK_MISSED_DAEMON_DOWN
       the daemon was down for 9m00s
       -> treat these rows as outage evidence, not as measurements
       -> compare them against the daemon session rows covering the same period
       2 schedules were due in this window
  2026-09-23 10:01:00Z  triggered tick         01M39A98M0  OK
      2026-09-24 09:00:00Z  accepted trigger      01M39A98M0  OK
               TRIGGER_ACCEPTED
               became a run
               -> nothing to fix; follow the run id on the trigger row
               -> dedup keys stay until retention clears them, so a deliberate rerun needs a new key or a bumped epoch
          2026-09-24 09:00:00Z  queued  run          01M39A98M0  WARN
  2026-09-23 09:01:00Z  skipped tick         01M39A98M0  x11 coalesced  WARN
       TICK_SKIPPED_PAUSED
       recorded by the explain fixture
       -> resume the source when it should fire again
       -> a pause survives restarts, so a pause nobody remembers is the first suspect for a silent job
