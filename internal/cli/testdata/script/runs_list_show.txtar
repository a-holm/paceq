# runs list shows the history newest first, and runs show answers with one
# run by its id or by any prefix that still names exactly one run.

exec paceq init
cp nightly.yaml jobs/nightly.yaml
cp import.yaml jobs/import.yaml
exec paceq apply

# Two runs of two jobs, an hour apart on the frozen clock. The listing is
# newest first, so the later run comes out on top.
env PULSEQ_FAKE_CLOCK=2026-09-24T09:05:00Z
exec paceq run import
env PULSEQ_FAKE_CLOCK=2026-09-24T09:10:00Z
exec paceq run nightly

exec paceq runs list -o json
cp stdout actual.json
maskfile actual.json
cmpjson actual.json expected_list.json

# A human at a terminal gets the same facts as a table.
exec paceq runs list -o text
stdout 'nightly'
stdout 'import'

# runs show answers with the full record, by the whole id ...
writeid nightly.id
wantexit 0 show.json show_err.txt runs show @nightly.id
maskfile show.json
cmpjson show.json expected_show.json

# ... by any prefix that still names exactly one run. A short form of the
# same id must answer with the very same record.
writeid -prefix=8 short.id
wantexit 0 prefix.json prefix_err.txt runs show @short.id
maskfile prefix.json
cmpjson prefix.json expected_show.json

# ... and refuses a prefix that matches more than one: both runs were
# minted in the same millisecond, so four characters name both.
writeid -prefix=4 ambiguous.id
wantexit 3 amb.json amb_err.txt runs show @ambiguous.id
grep 'matches more than one' amb_err.txt
grep 'give more characters' amb_err.txt

# A prefix nothing matches is a not-found, with a way forward.
wantexit 3 nf.json nf_err.txt runs show 01ZZZZZZZZZZZZZZZZZZZZZZZZZ
grep 'no run matches' nf_err.txt

-- nightly.yaml --
name: nightly
description: The long job that runs at night.
steps:
  - name: collect
    run: ["/bin/echo", "nightly done"]

-- import.yaml --
name: import
description: Bring yesterday's numbers in.
steps:
  - name: fetch
    run: ["/bin/echo", "import done"]

-- expected_list.json --
[
  {
    "available_at": "2026-09-24T09:10:00Z",
    "created_at": "2026-09-24T09:10:00Z",
    "finished_at": "2026-09-24T09:10:00Z",
    "id": "<RUN1>",
    "job": "nightly",
    "origin": "manual",
    "reason_code": "RUN_SUCCEEDED",
    "reason_data": "{}",
    "started_at": "2026-09-24T09:10:00Z",
    "state": "succeeded"
  },
  {
    "available_at": "2026-09-24T09:05:00Z",
    "created_at": "2026-09-24T09:05:00Z",
    "finished_at": "2026-09-24T09:05:00Z",
    "id": "<RUN2>",
    "job": "import",
    "origin": "manual",
    "reason_code": "RUN_SUCCEEDED",
    "reason_data": "{}",
    "started_at": "2026-09-24T09:05:00Z",
    "state": "succeeded"
  }
]
-- expected_show.json --
{
  "run": {
    "created_at": "2026-09-24T09:10:00Z",
    "finished_at": "2026-09-24T09:10:00Z",
    "id": "<RUN1>",
    "job": "nightly",
    "origin": "manual",
    "reason_code": "RUN_SUCCEEDED",
    "started_at": "2026-09-24T09:10:00Z",
    "state": "succeeded",
    "steps": [
      {
        "exit_code": 0,
        "log_path": "2026-09-24/<RUN1>/collect.1.ndjson",
        "name": "collect",
        "reason_code": "STEP_SUCCEEDED",
        "state": "succeeded"
      }
    ]
  }
}
