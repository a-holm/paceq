# shadow report / shadow status goldens (#32): the migrator's diff between
# what Pulseq would have done and what cron actually did. Presentation is
# isolated by planting rows through the store API on a frozen clock; the
# --json documents are the stability contract.

exec paceq init

env PULSEQ_FAKE_CLOCK=2027-01-11T09:00:00Z
plantschedule sync-files five '*/5 * * * *'
plantschedule reports hourly '0 * * * *'
plantschedule weekly jan '0 9 * * 1'
plantschedule legacy cron '45 14 * * *'

# three clean would-runs, each seen from cron two seconds late: agreement
plantshadow sync-files five TRIGGERED 3
plantobs journald sync-files -89m59s /usr/local/bin/sync-files
plantobs journald sync-files -84m59s /usr/local/bin/sync-files
plantobs journald sync-files -79m59s /usr/local/bin/sync-files

# hourly with observed starts an hour later every time: the drift signature
plantshadow reports hourly TRIGGERED 2
plantobs journald reports -30m0s /usr/bin/build-report
plantobs journald reports -25m0s /usr/bin/build-report

# seven fires cron started where overlap protection would stand down
plantshadow weekly jan OVERLAP 7
plantobs journald weekly -85m0s /usr/sbin/janitor --weekly
plantobs journald weekly -70m0s /usr/sbin/janitor --weekly

wantexit 0 report.json report_err.txt shadow report --since 48h --json
maskfile report.json
cmpjson report.json shadow_report_golden.json

# The text form repeats the one sentence nobody may miss.
wantexit 0 report.txt report_txt_err.txt shadow report --since 48h -o text
grep 'SHADOW MODE' report.txt
grep 'Comparison source: journald' report.txt
grep 'steady' report.txt

-- shadow_report_golden.json --
{
  "evidence": {
    "first_evidence": "2027-01-11T09:00:00Z",
