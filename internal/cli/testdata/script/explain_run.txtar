# explain run turns one run into its whole story: the trigger and tick that
# caused it, every step with attempts and exit codes, the error tail from the
# database, and the ways forward. Prefix resolution works like git: any prefix
# that names exactly one run, and an ambiguous one refuses naming candidates.

exec paceq init
plantschedule import-file hourly "@hourly"
plantscheduletick import-file hourly TRIGGERED key

writeid short.id

# wantexit expands the @FILE argument the way a user hands over an id.
wantexit 0 raw_run.txt raw_run_err.txt explain run @short.id -o text
grep 'daemon down' raw_run_err.txt
cp raw_run.txt actual_run.txt
maskfile actual_run.txt
cmp actual_run.txt expected_run.txt

wantexit 0 raw_run.json raw_run_err2.txt explain run @short.id -o json
cp raw_run.json actual_run.json
maskfile actual_run.json
cmpjson actual_run.json expected_run.json

# A whole id resolves to exactly itself.
wantexit 0 whole_run.json whole_err.txt explain run @short.id --since 1h -o json
maskfile whole_run.json
cmpjson whole_run.json expected_whole_run.json

# An unknown prefix is a not-found, not a crash; an invalid one says why.
wantexit 3 unknown_out.txt unknown_err.txt explain run run/ZZZZZZ
grep 'no run matches' unknown_err.txt
wantexit 2 syntax_out.txt syntax_err.txt explain run run/hello-world
grep 'is not a run id or prefix' syntax_err.txt

# A second trigger makes any short prefix ambiguous across the job's runs:
# the refusal names every candidate instead of guessing.
plantscheduletick import-file hourly TRIGGERED key2 -at=30m
writeid -prefix=4 both.id
wantexit 3 amb_out.txt amb_err.txt explain run @both.id
grep 'matches 2 runs' amb_err.txt

-- expected_run.txt --
run <RUN1> - job import-file - queued WARN
  scheduled for 2026-09-23T09:01:00Z
  run_key      key-0
  started by   trigger 01M39A98M0 (scheduler), run_key key-0
  fired by     scheduler tick 01M39A98M0 at 2026-09-23T09:01:00Z

  step build: pending WARN
    attempt 0 of 1

  -> logs:   paceq logs <RUN1>
