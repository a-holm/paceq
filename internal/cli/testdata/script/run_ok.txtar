# A job that works ends exit 0: the run record goes to stdout as JSON in a
# pipe, and the progress lines go to stderr, so a pipe of records stays
# parseable. This is the golden for the record a successful run writes.

exec paceq init
cp nice.yaml jobs/nice.yaml
exec paceq apply

wantexit 0 run.json run_err.txt run nice
maskfile run.json
cmpjson run.json run_record_golden.json

# Progress named the run while it worked; data did not mix with it.
grep 'run ' run_err.txt

# The history agrees with what the run just said.
wantexit 0 list.json list_err.txt runs list -o json
maskfile list.json
cmpjson list.json list_golden.json

-- nice.yaml --
name: nice
description: One step, no trouble.
steps:
  - name: greet
    run: ["/bin/echo", "hello from paceq"]

-- run_record_golden.json --
{
  "run": {
    "created_at": "2026-09-24T09:00:00Z",
    "finished_at": "2026-09-24T09:00:00Z",
    "id": "<RUN1>",
    "job": "nice",
    "origin": "manual",
    "reason_code": "RUN_SUCCEEDED",
    "started_at": "2026-09-24T09:00:00Z",
    "state": "succeeded",
    "steps": [
      {
        "exit_code": 0,
        "log_path": "2026-09-24/<RUN1>/greet.1.ndjson",
        "name": "greet",
        "reason_code": "STEP_SUCCEEDED",
        "state": "succeeded"
      }
    ]
  }
}
-- list_golden.json --
[
  {
    "created_at": "2026-09-24T09:00:00Z",
    "finished_at": "2026-09-24T09:00:00Z",
    "id": "<RUN1>",
    "job": "nice",
    "origin": "manual",
    "reason_code": "RUN_SUCCEEDED",
    "started_at": "2026-09-24T09:00:00Z",
    "state": "succeeded"
  }
]
