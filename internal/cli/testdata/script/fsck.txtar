# fsck is the invariant sweep: a clean project passes with nothing to
# report, and a state whose event chain does not add up is reported by
# name. The planted break here is the one the public API can write: two
# events that tell different stories about the same run, which is
# invariant I15. Its grade is warning: the exit code contract is graded
# (M6-06), so a historic finding is listed and still exits 0.

exec paceq init
cp nightly.yaml jobs/nightly.yaml
exec paceq apply
exec paceq run nightly

# The state a normal run leaves behind is sound.
exec paceq fsck -o json
stdout '"count":0'

# Two events claim the run went queued to running and queued to failed.
plantrun nightly
wantexit 0 fk.json - fsck
grep '"check":"I15"' fk.json
grep '"severity":"warning"' fk.json
grep 'event chain breaks' fk.json

-- nightly.yaml --
name: nightly
description: The long job that runs at night.
steps:
  - name: collect
    run: ["/bin/echo", "nightly done"]
