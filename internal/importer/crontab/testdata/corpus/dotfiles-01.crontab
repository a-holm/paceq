# Personal crontab: backups and cleanup
MAILTO=me@example.com
PATH=/usr/local/bin:/usr/bin:/bin

# nightly backup
0 2 * * * rsync -a --delete /home/me/Documents/ /mnt/backup/documents/
30 2 * * * /usr/local/bin/backup-db.sh >> /var/log/backup-db.log 2>&1
# weekly full backup on sundays
0 3 * * 0 /usr/local/bin/backup-full.sh > /dev/null 2>&1
